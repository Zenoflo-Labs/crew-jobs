# Names only. Never put real values in this file or in Git.
# Local use needs none of these: npm start works without a .env file.

# local, staging or production. Defaults to local.
APP_ENV=
# Required outside local. A Postgres 18 connection string.
DATABASE_URL=
# Required outside local. Password for the seeded fake test accounts.
SEED_PASSWORD=
# Optional. The deployed commit hash, shown by /health.
COMMIT_SHA=
# Optional. Defaults to 3000.
PORT=
